{
  "entities": {
    "CommanderProfile": {
      "title": "CommanderProfile",
      "description": "Persistent cloud profile and resource treasury for an authenticated medieval RTS commander (no PII stored).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the commander.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Public commander title in the realm.",
          "minLength": 1,
          "maxLength": 40
        },
        "factionName": {
          "type": "string",
          "description": "Medieval faction designation.",
          "minLength": 1,
          "maxLength": 60
        },
        "color": {
          "type": "string",
          "description": "Hex color string representing the commander's banner.",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "wood": {
          "type": "number",
          "description": "Stored timber resource amount."
        },
        "stone": {
          "type": "number",
          "description": "Stored cut stone resource amount."
        },
        "gold": {
          "type": "number",
          "description": "Stored gold bullion resource amount."
        },
        "food": {
          "type": "number",
          "description": "Stored grain/provisions resource amount."
        },
        "cameraX": {
          "type": "number",
          "description": "Last saved strategic camera X coordinate."
        },
        "cameraZ": {
          "type": "number",
          "description": "Last saved strategic camera Z coordinate."
        },
        "cameraZoom": {
          "type": "number",
          "description": "Last saved strategic camera zoom level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of initial profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last profile sync."
        }
      },
      "required": [
        "ownerId",
        "displayName",
        "factionName",
        "color",
        "wood",
        "stone",
        "gold",
        "food",
        "cameraX",
        "cameraZ",
        "cameraZoom",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudStructure": {
      "title": "CloudStructure",
      "description": "Persistent medieval structure built and upgraded by a commander on the shared cloud map.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the structure owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerColor": {
          "type": "string",
          "description": "Hex color of the owning faction.",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "kind": {
          "type": "string",
          "description": "Type of medieval structure.",
          "enum": ["house", "market", "temple", "keep", "barracks", "lumber_camp", "quarry", "watchtower"],
          "minLength": 4,
          "maxLength": 24
        },
        "level": {
          "type": "number",
          "description": "Architectural evolution tier (1, 2, or 3)."
        },
        "x": {
          "type": "number",
          "description": "World X coordinate on the tactical grid."
        },
        "z": {
          "type": "number",
          "description": "World Z coordinate on the tactical grid."
        },
        "rotationY": {
          "type": "number",
          "description": "Y-axis rotation in radians."
        },
        "hp": {
          "type": "number",
          "description": "Current structure hitpoints."
        },
        "maxHp": {
          "type": "number",
          "description": "Maximum structure hitpoints."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when built."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last upgraded or modified."
        }
      },
      "required": [
        "ownerId",
        "ownerColor",
        "kind",
        "level",
        "x",
        "z",
        "rotationY",
        "hp",
        "maxHp",
        "createdAt",
        "updatedAt"
      ]
    },
    "CloudUnit": {
      "title": "CloudUnit",
      "description": "Persistent medieval military or worker unit commanded on the shared cloud map.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "Firebase Auth UID of the unit owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerColor": {
          "type": "string",
          "description": "Hex color of the owning faction.",
          "minLength": 4,
          "maxLength": 16,
          "pattern": "^#[0-9a-fA-F]{3,8}$"
        },
        "kind": {
          "type": "string",
          "description": "Unit class.",
          "enum": ["worker", "infantry", "knight"],
          "minLength": 6,
          "maxLength": 16
        },
        "x": {
          "type": "number",
          "description": "Current world X position."
        },
        "z": {
          "type": "number",
          "description": "Current world Z position."
        },
        "targetX": {
          "type": "number",
          "description": "Target world X destination."
        },
        "targetZ": {
          "type": "number",
          "description": "Target world Z destination."
        },
        "rotationY": {
          "type": "number",
          "description": "Heading angle in radians."
        },
        "speed": {
          "type": "number",
          "description": "Movement speed in meters per second."
        },
        "state": {
          "type": "string",
          "description": "Current tactical state.",
          "enum": ["idle", "moving", "gathering"],
          "minLength": 4,
          "maxLength": 16
        },
        "hp": {
          "type": "number",
          "description": "Current unit health."
        },
        "maxHp": {
          "type": "number",
          "description": "Maximum unit health."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when trained."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last order."
        }
      },
      "required": [
        "ownerId",
        "ownerColor",
        "kind",
        "x",
        "z",
        "targetX",
        "targetZ",
        "rotationY",
        "speed",
        "state",
        "hp",
        "maxHp",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/commanders/{commanderId}": {
      "schema": { "$ref": "#/entities/CommanderProfile" },
      "description": "Stores each authenticated commander's persistent resource treasury, faction identity, and strategic camera bookmark."
    },
    "/structures/{structureId}": {
      "schema": { "$ref": "#/entities/CloudStructure" },
      "description": "Stores all medieval structures and their evolution tiers (Level 1-3) on the shared cloud realm."
    },
    "/units/{unitId}": {
      "schema": { "$ref": "#/entities/CloudUnit" },
      "description": "Stores all active medieval units and their tactical movement orders on the shared cloud realm."
    }
  }
}
